# ---------- HotelOps Guard ----------
# Salin file ini menjadi `.env` dan sesuaikan nilainya.
# Jangan commit `.env` berisi secret asli ke repository.

# Database URL. Default lingkungan development memakai SQLite lokal (tanpa server).
# Untuk PostgreSQL (mis. lewat docker-compose):
# DATABASE_URL="postgresql://hotelops:hotelops@localhost:5432/hotelops"
DATABASE_URL="file:./dev.db"

# Secret sesi Auth.js. Generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-string-panjang"

# Base URL aplikasi untuk production
AUTH_URL="http://localhost:3000"

# Mode development. Simulator perangkat pintu hanya aktif bila ini "true".
ENABLE_SIMULATOR="true"

# Provider dev-simulation untuk forwarder event webhook (opsional)
SIMULATION_FORWARD_URL=""

# Secret HMAC-SHA256 untuk POST /api/doors/events. Tanpa nilai ini endpoint
# menolak semua permintaan (fail closed). Generate: openssl rand -hex 32
DOOR_WEBHOOK_SECRET=""

# ---------- PostgreSQL (docker-compose) ----------
POSTGRES_USER="hotelops"
POSTGRES_PASSWORD="hotelops"
POSTGRES_DB="hotelops"
